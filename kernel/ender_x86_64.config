# Ender-OS v0.4 — Minimal x86_64 Linux 6.18 LTS Çekirdek Yapılandırması (Ağ + VirtIO + ext4 + Rust LKM)
CONFIG_LOCALVERSION="-ender"
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_SHMEM=y

# Çalıştırılabilir dosya biçimleri (ELF + #! betikler)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Initramfs (gzip ile sıkıştırılmış cpio kök dosya sistemi)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Sanal dosya sistemleri (/proc, /sys, /dev, /tmp)
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Konsol ve seri port (QEMU -nographic console=ttyS0)
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# PCI ve ACPI (temiz poweroff/reboot için gerekli)
CONFIG_PCI=y
CONFIG_PM=y
CONFIG_ACPI=y

# Yüklenebilir çekirdek modülleri (LKM) ve Rust-for-Linux
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KALLSYMS=y
CONFIG_RUST=y

# Ağ yığını (TCP/IP, Unix soketler) ve VirtIO-Net
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y

# Kalıcı blok aygıtı (VirtIO-Blk) ve ext4 dosya sistemi
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
