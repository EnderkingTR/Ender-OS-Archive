# Ender-OS v0.6 — x86_64 Linux 6.18 LTS Çekirdek Yapılandırması (GPU + Ses + Konteyner + Rust LKM)
CONFIG_LOCALVERSION="-ender"
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_SHMEM=y

# Çalıştırılabilir dosya biçimleri (ELF + #! betikler)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Initramfs (gzip ile sıkıştırılmış cpio kök dosya sistemi)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Sanal dosya sistemleri (/proc, /sys, /dev, /tmp)
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Konsol ve seri port (QEMU -nographic console=ttyS0)
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# PCI ve ACPI (temiz poweroff/reboot için gerekli)
CONFIG_PCI=y
CONFIG_PM=y
CONFIG_ACPI=y

# Yüklenebilir çekirdek modülleri (LKM) ve Rust-for-Linux
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KALLSYMS=y
CONFIG_RUST=y

# Ağ yığını (TCP/IP, Unix soketler) ve VirtIO-Net
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y

# Kalıcı blok aygıtı (VirtIO-Blk) ve ext4 dosya sistemi
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y

# Ekran, Framebuffer (/dev/fb0), sanal konsol (tty0) ve UEFI desteği
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# Klavye girişi (PS/2 i8042 + AT klavye — QEMU & VirtualBox için)
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y

# 3B GPU (DRM + VirtIO-GPU), Fare (evdev) ve Ses (Intel HD Audio)
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y

# Systemd, Docker/Konteyner ve Steam Proton gereksinimleri
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_PSI=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
